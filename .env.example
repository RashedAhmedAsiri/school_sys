# PostgreSQL connection string (Neon, Supabase, Railway, or the docker-compose database)
DATABASE_URL="postgresql://school:school@localhost:5432/school"

# Long random string used to sign login cookies (generate with: openssl rand -hex 32)
SESSION_SECRET="change-me-to-a-long-random-string"

# The shared site password a teacher needs to create an account
SITE_PASSWORD="123323"

# Claude API key from https://console.anthropic.com
ANTHROPIC_API_KEY=""

# Optional
# AI_MODEL="claude-opus-5-5"
# SCHOOL_TZ="Asia/Riyadh"
